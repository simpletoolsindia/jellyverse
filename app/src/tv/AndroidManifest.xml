<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Wi-Fi state is only read for the phone remote; Ethernet-only TVs must still be able to install. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- TV remotes keep the classic Back key handling (no predictive back gesture on TV). -->
    <application
        android:banner="@drawable/tv_banner"
        android:enableOnBackInvokedCallback="false"
        tools:replace="android:enableOnBackInvokedCallback">

        <!-- The phone shell is not used on TV -->
        <activity android:name=".MainActivity" tools:node="remove" />

        <activity
            android:name=".tv.TvActivity"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Harbor"
            android:configChanges="keyboard|keyboardHidden|navigation">
            <intent-filter>
                <!-- Google Assistant: "Play … on JellyVerse" -->
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Play Next" and the JellyVerse row on the TV home screen open titles here -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="jellyversetv" android:host="play" />
                <data android:scheme="jellyversetv" android:host="item" />
                <data android:scheme="jellyversetv" android:host="home" />
            </intent-filter>
        </activity>
    </application>
</manifest>
