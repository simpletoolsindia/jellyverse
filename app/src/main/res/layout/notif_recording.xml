<?xml version="1.0" encoding="utf-8"?>
<!-- Radio recording notification. Animated by the system (ViewFlipper + Chronometer), so the app does no work to animate it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="4dp">

    <!-- Progress ring with the live level meter inside -->
    <FrameLayout android:layout_width="48dp" android:layout_height="48dp">
        <ProgressBar android:id="@+id/rec_progress" style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="48dp" android:layout_height="48dp" android:max="1000" android:indeterminate="false"
            android:progressDrawable="@drawable/ring_progress_red" />
            <!-- Live level meter -->
            <ViewFlipper android:id="@+id/rec_level" android:layout_gravity="center" android:layout_width="22dp" android:layout_height="14dp"
                android:autoStart="true" android:flipInterval="170">
                <ImageView android:layout_width="22dp" android:layout_height="14dp" android:src="@drawable/rec_level_1" />
                <ImageView android:layout_width="22dp" android:layout_height="14dp" android:src="@drawable/rec_level_2" />
                <ImageView android:layout_width="22dp" android:layout_height="14dp" android:src="@drawable/rec_level_3" />
                <ImageView android:layout_width="22dp" android:layout_height="14dp" android:src="@drawable/rec_level_4" />
                <ImageView android:layout_width="22dp" android:layout_height="14dp" android:src="@drawable/rec_level_2" />
                <ImageView android:layout_width="22dp" android:layout_height="14dp" android:src="@drawable/rec_level_5" />
            </ViewFlipper>
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <!-- Blinking REC dot -->
        <ViewFlipper android:id="@+id/rec_dot" android:layout_width="12dp" android:layout_height="12dp"
            android:autoStart="true" android:flipInterval="600">
            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/rec_dot_on" />
            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/rec_dot_off" />
        </ViewFlipper>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:text="REC" android:textColor="#E8505B" android:textStyle="bold" android:textSize="13sp" android:letterSpacing="0.08" />
        <Chronometer android:id="@+id/rec_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" style="@style/TextAppearance.Compat.Notification.Title" android:textSize="15sp" />
        <TextView android:id="@+id/rec_total" android:layout_width="wrap_content" android:layout_height="wrap_content"
            style="@style/TextAppearance.Compat.Notification.Info" android:textSize="13sp" />
    </LinearLayout>

    <TextView android:id="@+id/rec_station" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:singleLine="true" android:ellipsize="end"
        style="@style/TextAppearance.Compat.Notification.Line2" />

    <TextView android:id="@+id/rec_size" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" style="@style/TextAppearance.Compat.Notification.Info" />
    </LinearLayout>
</LinearLayout>
