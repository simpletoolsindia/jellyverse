<resources>
    <color name="ink">#0F1014</color>

    <style name="Theme.Harbor" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Harbor.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Harbor</item>
    </style>

    <style name="Theme.Harbor.Player" parent="Theme.Harbor">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
