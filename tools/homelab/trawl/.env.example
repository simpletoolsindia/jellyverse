# Copy to .env (chmod 600). Tuned for a Raspberry Pi 5 (4–8 GB) that also runs the media stack.
LOG_LEVEL=info
# One warm browser, one content process: ~400–700 MB RAM while solving, ~250 MB idle.
BROWSER_POOL_SIZE=1
BROWSER_MAX_CONTENT_PROCESSES=1
BROWSER_HEADFUL_POOL_SIZE=0
# The Pi's CPU is slower than a desktop: give browser launch and challenges more time.
BROWSER_LAUNCH_TIMEOUT_MS=150000
BROWSER_ACQUIRE_TIMEOUT_MS=30000
BROWSER_RECYCLE_AFTER_CONTEXTS=6
# Solved sessions reused for 6 h: most indexer searches then skip the browser entirely.
REDIS_SESSION_TTL_SECONDS=21600
# Local dashboard at http://<pi>:8191/dashboard – protect it with a random 32+ char token:
#   openssl rand -hex 24
METRICS_DASHBOARD_TOKEN=
MCP_ENABLED=false
# Optional: proxies for sites that block home IPs (leave empty to disable those tiers).
PROXY_URL=
RESIDENTIAL_PROXY_URL=
